OPENAI_API_KEY=sk...
SUPABASE_URL=https...
SUPABASE_ANON_KEY=ey...supabaseanonkey
SUPABASE_SERVICE_KEY=ey...supabasekey
STRIPE_SECRET_KEY=sk...stripekey
STRIPE_WEBHOOK_SECRET=whsec_...stripewebhooksecret
STRIPE_PRICE_STARTER=p...stripestarterprice
STRIPE_PRICE_PRO=p...stripeproprice
GOOGLE_PROJECT_ID=googleprojectid
GOOGLE_PRIVATE_KEY_ID=googleprivatekeyid
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_EMAIL=serviceaccountemail
DEBUG=true
MAX_FILE_SIZE_MB=10
# Frontend URL used after successful integration OAuth callbacks
FRONTEND_APP_URL=http://localhost:3000

# Base64url-encoded 32-byte AES-256-GCM key for OAuth tokens.
TOKEN_ENCRYPTION_KEY=GENERATE_WITH_scripts/generate_token_encryption_key.py

# Redis (required for distributed caching, queues and rate limiting)
# Local Redis example. Production should use a managed Redis endpoint (for example Upstash).
# Upstash supplies a rediss://... connection URL; paste that full URL here.
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=100

# Distributed scheduler locking. Keep enabled in production.
SCHEDULER_LOCK_ENABLED=true
SCHEDULER_LOCK_TTL_SECONDS=300
SCHEDULER_LOCK_FAIL_OPEN=false

GOOGLE_LOCATION=us
GOOGLE_PROCESSOR_ID=your-document-ai-processor-id
